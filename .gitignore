# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# Data files (scraped targets & temporary dumps)
app/data/*.json
!app/data/.gitkeep

# The Paper Trade Log and its cursors. An experimental record accumulated by a
# long-running poller, not source: committing it would make every poll a diff.
app/data/paper_trades.jsonl
app/data/paper_trade_state.json

# Environment & logs
.env
.env.*
*.log
venv/
ENV/
.venv/

# IDE & OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db

# Dependencies
node_modules/
.freebuff/desktop-v2.db
.freebuff/desktop-v2.db-shm
.freebuff/desktop-v2.db-wal
app/data/run_mock_cache/

# Scratch artifacts from side sessions. Not part of any change.
.freebuff/
